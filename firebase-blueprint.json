{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student master data",
      "type": "object",
      "properties": {
        "nis": { "type": "string" },
        "nisn": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "absensiNo": { "type": "string" },
        "gender": { "type": "string" }
      },
      "required": ["nis", "name", "className"]
    },
    "StudentPII": {
      "title": "Student PII",
      "description": "Student sensitive information (DOB/Address)",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "address": { "type": "string" }
      },
      "required": ["studentId", "dateOfBirth", "address"]
    },
    "Teacher": {
      "title": "Teacher / Homeroom Teacher",
      "description": "Teacher profiles",
      "type": "object",
      "properties": {
        "nip": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "array" },
        "subjects": { "type": "array" },
        "taughtClasses": { "type": "array" }
      },
      "required": ["nip", "name", "className"]
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Absensi submission (Sakit/Izin/Dispensasi)",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "date": { "type": "string" },
        "day": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "type": { "enum": ["Sakit", "Izin", "Dispensasi"] },
        "reason": { "type": "string" },
        "status": { "enum": ["Pending", "Approved", "Rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "type", "date", "status"]
    },
    "SubjectInquiry": {
      "title": "Subject Teacher Inquiry",
      "description": "Inquiry from subject teacher about missing student",
      "type": "object",
      "properties": {
        "subjectTeacherName": { "type": "string" },
        "subjectTeacherId": { "type": "string" },
        "subjectName": { "type": "string" },
        "className": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "enum": ["Menunggu", "Dijawab"] },
        "message": { "type": "string" },
        "response": { "type": "string" },
        "respondedBy": { "type": "string" },
        "respondedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "date": { "type": "string" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "period": { "type": "string" },
        "replies": { "type": "array" }
      }
    },
    "SchoolData": {
      "title": "School Data",
      "description": "School information for reports and administration",
      "type": "object",
      "properties": {
        "pemda": { "type": "string" },
        "dinas": { "type": "string" },
        "sekolah": { "type": "string" },
        "alamat": { "type": "string" },
        "kota": { "type": "string" },
        "kepalaSekolah": { "type": "string" },
        "nipKepalaSekolah": { "type": "string" }
      }
    },
    "AttendanceAlert": {
      "title": "Attendance Alert",
      "description": "Early warning system for absences",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "alertType": { "enum": ["consecutive", "total"] },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "resolved"] }
      },
      "required": ["studentId", "alertType", "details", "createdAt", "status"]
    },
    "SubjectAttendance": {
      "title": "Subject Teacher Attendance",
      "description": "Attendance log for a specific subject class session",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "subjectName": { "type": "string" },
        "teacherName": { "type": "string" },
        "date": { "type": "string" },
        "period": { "type": "string" },
        "status": { "enum": ["S", "I", "D", "A", "H"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification",
      "type": "object",
      "properties": {
        "className": { "type": "string" },
        "studentName": { "type": "string" },
        "studentId": { "type": "string" },
        "teacherName": { "type": "string" },
        "subjectName": { "type": "string" },
        "message": { "type": "string" },
        "title": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "targetRole": { "type": "string" },
        "targetUserId": { "type": "string" }
      }
    },
    "SchoolPresence": {
      "title": "School Presence",
      "description": "Daily school presence (arrival, activity, departure)",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "type": { "enum": ["arrival", "activity", "departure"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "activityName": { "type": "string" }
      },
      "required": ["studentId", "type", "timestamp"]
    },
    "Tugas": {
      "title": "Tugas (Task)",
      "description": "Assignments or tasks given by teachers",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "enum": ["Aktif", "Selesai", "Terlambat"] },
        "className": { "type": "string" },
        "subjectName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "dueDate", "className", "teacherId"]
    },
    "AcademicCalendar": {
      "title": "Academic Calendar Event",
      "description": "Information about school events, holidays, and deadlines",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "type": { "enum": ["Libur", "Acara", "Ujian", "Raport", "Lainnya"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "startDate", "type"]
    },
    "SchoolConfig": {
      "title": "School Config",
      "description": "School operational configuration",
      "type": "object",
      "properties": {
        "entryTime": { "type": "string" },
        "departureTime": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/subjectAttendance/{id}": {
      "schema": "SubjectAttendance",
      "description": "Attendance logs from subject teachers"
    },
    "/schoolData/{id}": {
      "schema": "SchoolData",
      "description": "School information management"
    },
    "/subjectInquiries/{inquiryId}": {
      "schema": "SubjectInquiry",
      "description": "Inquiries from subject teachers"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students"
    },
    "/student_pii/{studentId}": {
      "schema": "StudentPII",
      "description": "Collection of student PII"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Collection of teachers"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Collection of attendance records"
    },
    "/schoolPresence/{presenceId}": {
      "schema": "SchoolPresence",
      "description": "Collection of daily school presence logs"
    },
    "/schoolConfig/{configId}": {
      "schema": "SchoolConfig",
      "description": "School configuration settings"
    },
    "/attendance_alerts/{alertId}": {
      "schema": "AttendanceAlert",
      "description": "Collection of attendance alerts"
    },
    "/academicYears/{yearId}": {
      "schema": {
        "type": "object",
        "properties": {
          "year": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "description": "Academic years configuration"
    },
    "/notifications/{id}": {
      "schema": "Notification",
      "description": "System notifications"
    },
    "/tasks/{taskId}": {
      "schema": "Tugas",
      "description": "Assignments given by teachers to classes"
    },
    "/academicCalendar/{id}": {
      "schema": "AcademicCalendar",
      "description": "Collection of academic calendar events"
    },
    "/counselors/{counselorId}": {
      "schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "nip": { "type": "string" },
          "managedClasses": { "type": "array" }
        }
      },
      "description": "Counselor profiles"
    }
  }
}
