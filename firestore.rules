rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (request.auth.token.email == "wiwitpurnomo24@guru.smp.belajar.id" || request.auth.token.email.matches(".*@admin\\.system"))) ||
        (request.auth.token.name != null && request.auth.token.name.matches("(?i).*administrator.*")) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }
    
    function isTeacher() {
      return isSignedIn() && (
        (request.auth.token.name != null && (request.auth.token.name.matches("(?i).*guru.*") || request.auth.token.name.matches("(?i).*wali kelas.*"))) ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "TEACHER")
      );
    }

    function isCounselor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/counselors/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "COUNSELOR")
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "PETUGAS_ABSEN_KELAS")
      );
    }

    function isParent() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "PARENT")
      );
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Root Legacy Collections (Restores data visibility) ---
    match /schoolData/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schoolConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academicYears/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academicYear/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /systemSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schoolPresence/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher() || isOfficer();
    }
    match /attendance_alerts/{alertId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacher() || isCounselor() || isOfficer() || isSignedIn();
      allow update: if isAdmin() || isTeacher() || isCounselor();
      allow delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if true; 
      allow write: if isAdmin() || isTeacher();
    }
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /counselors/{counselorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher() || isCounselor() || isOfficer() || (isParent() && resource.data.studentId == request.auth.uid));
      allow create: if isSignedIn() || true; 
      allow update: if isSignedIn() && (isAdmin() || isTeacher() || isCounselor() || isOfficer());
      allow delete: if isAdmin() || isTeacher() || isCounselor();
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update: if true; 
      allow delete: if isAdmin();
    }
    match /grades/{id} {
      allow read, write: if true;
    }
    match /subjectAttendance/{id} {
      allow read, write: if true;
    }
    match /subjectInquiries/{id} {
      allow read, write: if true;
    }
    match /student_pii/{studentId} {
      allow read, write: if isAdmin();
    }

    match /schools {
      allow list: if isSignedIn();
    }
    match /schools/{schoolId} {
      allow read, write: if isSignedIn();
      // Public / Metadata Collections - Allow unrestricted read
      match /schoolData/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /schoolConfig/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /academicYears/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /academicYear/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /systemSettings/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /schoolPresence/{id} {
        allow read: if true;
        allow write: if isAdmin() || isTeacher() || isOfficer();
      }

      match /attendance_alerts/{alertId} {
        allow read: if true;
        allow create: if isAdmin() || isTeacher() || isCounselor() || isOfficer() || isSignedIn();
        allow update: if isAdmin() || isTeacher() || isCounselor();
        allow delete: if isAdmin();
      }

      match /students/{studentId} {
        allow read: if true; 
        allow write: if isAdmin() || isTeacher();
      }

      match /teachers/{teacherId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /counselors/{counselorId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /classes/{classId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /attendance/{attendanceId} {
        allow read: if isSignedIn() && (isAdmin() || isTeacher() || isCounselor() || isOfficer() || (isParent() && resource.data.studentId == request.auth.uid));
        allow create: if isSignedIn() || true; 
        allow update: if isSignedIn() && (isAdmin() || isTeacher() || isCounselor() || isOfficer());
        allow delete: if isAdmin() || isTeacher() || isCounselor();
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn();
        allow create, update: if true; 
        allow delete: if isAdmin();
      }

      match /grades/{id} {
        allow read, write: if true;
      }

      match /subjectAttendance/{id} {
        allow read, write: if true;
      }

      match /subjectInquiries/{id} {
        allow read, write: if true;
      }

      match /student_pii/{studentId} {
        allow read, write: if isAdmin();
      }
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
