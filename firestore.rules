rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (request.auth.token.email == "wiwitpurnomo24@guru.smp.belajar.id" || request.auth.token.email.endsWith("@admin.system"))) ||
        (request.auth.token.name != null && request.auth.token.name.matches("(?i).*administrator.*")) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }
    
    function isTeacher() {
      return isSignedIn() && (
        (request.auth.token.name != null && (request.auth.token.name.matches("(?i).*guru.*") || request.auth.token.name.matches("(?i).*wali kelas.*"))) ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "TEACHER")
      );
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /schoolPresence/{id} {
      allow get, list: if true;
      allow write: if true;
    }

    match /systemSettings/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /schoolConfig/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /schoolData/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /academicYears/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /counselors/{counselorId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isTeacher();
    }

    match /attendance_alerts/{alertId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /grades/{id} {
      allow get, list: if true;
      allow write: if true;
    }

    match /subjectAttendance/{id} {
      allow get, list, write: if true;
    }

    match /subjectInquiries/{id} {
      allow get, list, write: if true;
    }

    match /student_pii/{studentId} {
      allow read, write: if isAdmin();
    }
    
    match /admins/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
