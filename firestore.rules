rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "wiwitpurnomo24@guru.smp.belajar.id" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff(schoolId) {
      return isSystemAdmin() || (
        isSignedIn() && 
        userExists() && 
        (getUserData().get('schoolId', '') == schoolId || getUserData().get('schoolId', '') == 'default')
      );
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow list: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
    }

    match /admins/{userId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
    
    // Root collections (Fallback for when schoolId is 'default')
    match /schoolData/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /schoolConfig/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /academicYears/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /academicCalendar/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /classes/{id} { allow read: if true; allow write: if isSignedIn(); }

    match /subjectInquiries/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /subjectAttendance/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /attendance/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /tasks/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /students/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /teachers/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /schoolPresence/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /attendance_alerts/{id} { allow read: if true; allow write: if isSignedIn(); }

    // Isolated School Collections
    match /schools {
      allow read: if true;
    }
    
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isStaff(schoolId);
      
      match /{collection}/{id} {
        allow read: if true;
        allow write: if isStaff(schoolId) || isSignedIn();
      }

      match /notifications/{id} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
